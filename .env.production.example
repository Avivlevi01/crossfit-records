# PRODUCTION (the server). On the server: copy to .env and fill in. Never commit the real file.
# Generate every secret with:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"

# Your site address, no https:// (e.g. records.example.com). Caddy gets the HTTPS certificate for it.
DOMAIN=records.example.com

POSTGRES_USER=crossfit
POSTGRES_PASSWORD=CHANGE-ME-long-random
POSTGRES_DB=crossfit

SECRET_KEY=CHANGE-ME-at-least-32-random-characters
INVITE_CODE=CHANGE-ME-a-code-you-send-to-friends

# Production behaviour: HTTPS-only cookies + HSTS, API docs page hidden.
COOKIE_SECURE=true
ENABLE_DOCS=false
