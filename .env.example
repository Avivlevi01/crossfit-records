# LOCAL DEVELOPMENT. Copy to .env and change the values. .env is never committed.
POSTGRES_USER=crossfit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crossfit

# Signs the login cookie (32+ characters). Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-0123456789

# The shared code friends need in order to register.
INVITE_CODE=change-me

# Shows the automatic API docs at /docs (development only).
ENABLE_DOCS=true
