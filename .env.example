# Copy to .env and change the values. .env is never committed.
POSTGRES_USER=crossfit
POSTGRES_PASSWORD=change-me
POSTGRES_DB=crossfit

# Used later for login cookies. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# The shared code friends need in order to register.
INVITE_CODE=change-me
